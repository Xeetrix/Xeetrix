// Xeetrix — Prisma schema
// Provider is PostgreSQL by default (Vercel Postgres / Neon / Supabase /
// Railway all work as-is). For local dev without a Postgres instance,
// switch `provider` to "sqlite" and point DATABASE_URL at a local file —
// note SQLite does not support the String[] fields below, so swap those
// for a comma-joined String column if you go that route.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  IMPORTER
  EXPORTER
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(IMPORTER)
  company   String?
  phone     String?
  country   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[] @relation("ImporterProducts")

  @@map("users")
}

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  image       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]

  @@map("categories")
}

model Product {
  id          String @id @default(cuid())
  title       String
  slug        String @unique
  description String

  // wholesalePrice/moq mirror the entry-level tier (the priceTiers row
  // with the lowest minQty) so list pages, filters, the sitemap, and
  // JSON-LD can show a single "from" price without joining priceTiers.
  // The API derives and overwrites both from priceTiers on every
  // create/update — never edit them directly.
  wholesalePrice Float
  moq            Int   @default(1)

  regularPrice Float
  unit         String   @default("piece")
  stock        Int      @default(0)
  images       String[]
  isPublished  Boolean  @default(true)
  isFeatured   Boolean  @default(false)

  seoTitle       String?
  seoDescription String?

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  importerId String?
  importer   User?   @relation("ImporterProducts", fields: [importerId], references: [id], onDelete: SetNull)

  priceTiers PriceTier[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([importerId])
  @@map("products")
}

// Bulk/MOQ pricing tiers, e.g. "100 units @ ৳165", "200 units @ ৳160",
// "500 units @ ৳150". A product needs at least one tier — the API layer
// enforces that, not the schema, so a still-mid-edit product can't end
// up with a state the DB itself would reject.
model PriceTier {
  id     String @id @default(cuid())
  minQty Int
  price  Float

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([productId])
  @@map("price_tiers")
}
