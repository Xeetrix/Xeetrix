# Xeetrix — environment variables
# Copy this file to .env.local and fill in values as needed.
# The app builds and runs with none of these set: pages fall back to
# built-in mock catalog data whenever the database is unreachable. Once
# DATABASE_URL is set and reachable, the app reads/writes the real database
# exclusively — an empty table shows as empty, it is no longer masked by
# mock data.

# --- Database (Prisma) ---------------------------------------------------
# PostgreSQL is the target for production (Vercel Postgres, Neon, Supabase,
# Railway, etc. all work). For local development without any external
# service, point this at a local SQLite file instead and change the
# `provider` in prisma/schema.prisma from "postgresql" to "sqlite".
DATABASE_URL="postgresql://user:password@localhost:5432/xeetrix?schema=public"

# --- Site configuration ---------------------------------------------------
NEXT_PUBLIC_SITE_URL="https://xeetrix.com"
NEXT_PUBLIC_SITE_NAME="Xeetrix"

# WhatsApp number (with country code, no + or spaces) used by the
# "Order via WhatsApp" button on product pages and the contact form.
NEXT_PUBLIC_WHATSAPP_NUMBER="8809658036631"

# Contact email shown in the footer, contact page, and about page.
NEXT_PUBLIC_CONTACT_EMAIL="work.xeetrix@gmail.com"

# --- Admin auth ------------------------------------------------------------
# Seed credentials for the first ADMIN account (used by prisma/seed.ts).
# Change these before deploying, then manage additional users from /admin.
ADMIN_EMAIL="work.xeetrix@gmail.com"
ADMIN_PASSWORD="xeetrixadmin123"

# Secret used to sign admin session JWTs. Generate a strong random value,
# e.g. `openssl rand -base64 32`.
AUTH_SECRET="replace-with-a-long-random-string"
