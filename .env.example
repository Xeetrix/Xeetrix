# Xeetrix marketing site — environment variables
# Copy this file to .env.local and fill in values as needed.
# The site builds and runs with none of these set; they only unlock
# optional integrations (contact email routing, transactional email).

# --- Public site configuration -----------------------------------------
# Displayed in the footer, contact page, and used as the "to" address for
# form notifications. Falls back to a placeholder if unset.
NEXT_PUBLIC_CONTACT_EMAIL=hello@xeetrix.com
NEXT_PUBLIC_SUPPORT_EMAIL=support@xeetrix.com

# --- Transactional email (contact form / qualification tool) -----------
# Without RESEND_API_KEY, form submissions are still validated and
# accepted by the API routes, but no email notification is dispatched —
# submissions are only logged server-side. Set this to enable email
# delivery via Resend (https://resend.com).
RESEND_API_KEY=
# Sender address used for outgoing notification emails.
EMAIL_FROM=

# --- Analytics (optional) -----------------------------------------------
# Reserved for a future privacy-conscious analytics provider. Not wired
# to any vendor by default — no tracking scripts ship without this set.
NEXT_PUBLIC_ANALYTICS_PROVIDER=

# --- Shaikh OS / internal tooling ---------------------------------------
# The internal Shaikh OS command center (/os, /admin) and its Supabase,
# Google Workspace, GitHub, and Vercel integrations are unrelated to the
# public marketing site and documented separately in services/shaikh-agent
# and the Supabase migrations under supabase/migrations. See README.md.
